{
  "name": "parel-mvp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "packages/db/schema.prisma"
  },
  "scripts": {
    "prisma:generate": "pnpm --filter @parel/db run prisma:generate",
    "prisma:migrate:deploy": "tsx packages/db/scripts/db-migrate-deploy.ts",
    "prisma:db:pull": "pnpm --filter @parel/db exec prisma db pull",
    "generate:prisma": "node scripts/gen-prisma.js",
    "predev": "pnpm --filter @parel/core build",
    "dev": "pnpm dev:web",
    "daily": "powershell -ExecutionPolicy Bypass -File scripts/daily.ps1",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "cd apps/worker && pnpm run dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm -r run build",
    "build:light": "pnpm -w --filter @parel/web... --filter \"!@parel/story\" --filter \"!parel-mvp\" run build",
    "build:full": "pnpm -w -r run build",
    "install:light": "pnpm -w install --frozen-lockfile --filter @parel/web...",
    "install:full": "pnpm -w install --frozen-lockfile",
    "build:packages": "pnpm --filter \"@parel/*\" run build",
    "build:vercel": "pnpm -r --filter \"!@parel/story\" run build",
    "build:web": "pnpm --filter @parel/web... run build",
    "build:android": "cd apps/web && pnpm run build:android",
    "build:ios": "cd apps/web && pnpm run build:ios",
    "build:mobile": "cd apps/web && pnpm run build:mobile",
    "build:desktop": "cd apps/web && pnpm run build:desktop",
    "db:push": "pnpm --filter @parel/db prisma db push",
    "db:migrate": "cd packages/db && pnpm run prisma:migrate",
    "db:migrate:dev": "cross-env APP_ENV=dev tsx packages/db/scripts/db-migrate-dev.ts",
    "db:doctor": "tsx packages/db/scripts/db-doctor.ts",
    "db:doctor:dev": "cross-env APP_ENV=dev tsx packages/db/scripts/db-doctor.ts",
    "db:doctor:prod": "cross-env APP_ENV=prod tsx packages/db/scripts/db-doctor.ts",
    "db:seed": "tsx packages/db/seed.ts",
    "db:seed:demo": "cross-env APP_ENV=dev tsx packages/db/scripts/seed-demo-minimal.ts",
    "db:seed:big": "cross-env APP_ENV=dev tsx packages/db/scripts/seed-demo-big.ts",
    "db:seed:world": "cross-env APP_ENV=dev tsx packages/db/scripts/seed-world.ts",
    "db:seed:milestones": "cross-env APP_ENV=dev tsx packages/db/scripts/seed-milestones.ts",
    "db:seed:world:full": "pnpm db:seed:world && pnpm db:seed:milestones",
    "db:questions:import-sync": "tsx packages/db/scripts/question-import-sync.ts",
    "db:questions:import": "cross-env APP_ENV=dev tsx packages/db/scripts/question-import.ts",
    "db:questions:publish": "cross-env APP_ENV=dev tsx packages/db/scripts/question-publish.ts",
    "db:questions:archive": "cross-env APP_ENV=dev tsx packages/db/scripts/question-archive.ts",
    "db:questions:stats:backfill": "cross-env APP_ENV=dev tsx packages/db/scripts/question-stats-backfill.ts",
    "db:questions:smoke": "cross-env APP_ENV=dev tsx packages/db/scripts/question-pipeline-smoke.ts",
    "validate:questions": "cross-env APP_ENV=dev tsx packages/db/scripts/validate-questions.ts",
    "db:reset:world": "cross-env APP_ENV=dev tsx packages/db/scripts/db-reset-world.ts",
    "seed:flow-dev": "tsx apps/web/scripts/seed-flow-dev.ts",
    "db:reset": "pnpm db:push && pnpm db:seed",
    "db:reset-seed": "pnpm db:reset",
    "db:studio": "cd packages/db && pnpm exec prisma studio",
    "watchdog": "tsx scripts/db-watchdog.ts",
    "watchdog:ci": "tsx scripts/ci-watchdog.ts",
    "dev:watchdog": "pnpm watchdog && pnpm dev",
    "dev:web:watchdog": "pnpm watchdog && pnpm dev:web",
    "gen:questions": "cd apps/web && pnpm run gen:questions",
    "check:changelog": "node scripts/check-changelog.js",
    "check:command-docs": "node scripts/check-command-docs.mjs",
    "docs:commands:update": "node scripts/update-command-docs-hash.mjs",
    "check:routes": "node scripts/check-api-route-duplicates.mjs",
    "check:dynamic-routes": "node scripts/check-next-dynamic-route-collisions.mjs",
    "check:page-duplicates": "node scripts/check-page-duplicates.mjs",
    "check:dev-sanity": "pnpm -w check:routes && pnpm -w check:page-duplicates && pnpm -w check:dynamic-routes && pnpm -w check:command-docs",
    "web:check-imports": "node apps/web/check-imports.js",
    "lint": "pnpm run lint:web && pnpm run lint:worker",
    "lint:web": "cd apps/web && pnpm run lint",
    "lint:worker": "cd apps/worker && pnpm run lint",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -C apps/web run test",
    "test:web": "pnpm run test:unit",
    "test:watch": "pnpm -C apps/web run test:watch",
    "test:coverage": "pnpm -C apps/web run test:coverage",
    "test:social": "pnpm -C apps/web run test:social",
    "test:e2e": "pnpm -C apps/web run test:e2e",
    "test:e2e:ui": "pnpm -C apps/web run test:e2e:ui",
    "test:smoke": "pnpm smoke:flow",
    "test:milestones": "cross-env APP_ENV=dev tsx apps/web/scripts/test-milestones.ts",
    "test:ci": "pnpm test:unit && pnpm test:smoke",
    "e2e:local": "cross-env BASE_URL=http://localhost:3001 REVIEW_MODE=true playwright test -c e2e/playwright.config.ts",
    "e2e:preview": "cross-env REVIEW_MODE=true playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install --with-deps",
    "smoke:flow": "tsx apps/web/scripts/smoke-flow.ts",
    "smoke:web": "powershell -ExecutionPolicy Bypass -File scripts/smoke-web.ps1",
    "typecheck": "pnpm --filter @parel/web run typecheck",
    "clean": "pnpm lint:fix && pnpm typecheck",
    "clean:fix": "cd apps/web && pnpm lint:fix",
    "clean:check": "pnpm lint && pnpm typecheck",
    "kill": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 3001",
    "kill:3001": "pnpm kill",
    "validate": "powershell -ExecutionPolicy Bypass -File scripts/validate.ps1",
    "start:web": "pnpm --filter @parel/web... run start -- -p 3011",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "help": "node -e \"console.log('See docs/COMMANDS.md')\"",
    "prepare": "husky install",
    "wiki:enrich": "cross-env APP_ENV=dev tsx scripts/wiki-enrich.ts",
    "wiki:report": "node -e \"console.log(require('path').resolve(process.cwd(), 'docs', 'wiki-enrich-report.md'))\""
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "dotenv": "^17.2.3",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/supertest": "^6.0.3",
    "@upstash/ratelimit": "^2.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "jose": "^6.1.0",
    "jsdom": "^23.2.0",
    "lint-staged": "^15.2.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "next": "14.0.4",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/redis": "^1.35.4",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.23.22",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.2",
    "next-themes": "^0.4.6",
    "p-limit": "^7.1.1",
    "prisma": "^5.22.0",
    "resend": "^6.1.2",
    "stripe": "^19.0.0",
    "zod": "^4.1.11"
  }
}
